# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# ── AI 기능 ──────────────────────────────────────────────
# [주의] VITE_ 접두사가 붙은 값은 브라우저 번들에 그대로 포함됩니다.
# 운영 배포에서는 아래 키를 클라이언트에 두지 말고, ai-proxy 엣지 함수를 쓰세요.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy ai-proxy
# 그 뒤 VITE_AI_PROXY=1 로 전환하면 키가 서버에만 남습니다.
VITE_ANTHROPIC_KEY=
VITE_AI_PROXY=0

# ── 공휴일 정보 (공공데이터포털 특일 정보 API) ──────────────
# 비워두면 앱에 등록된 캘린더만 사용합니다.
VITE_HOLIDAY_KEY=

# ── 웹 푸시 (VAPID 공개키) ─────────────────────────────────
# 비워두면 푸시 알림 기능이 비활성화됩니다.
VITE_VAPID_PUBLIC_KEY=
